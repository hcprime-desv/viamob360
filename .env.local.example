# Copie para .env.local e preencha. Não commitar o .env.local de verdade.
# (Prefixo NEXT_PUBLIC_ porque o SDK do Firebase também roda no navegador
# — nos listeners em tempo real e no formulário de parceiro — mesmo
# agora que existe um servidor Node.js de verdade (SSR/ISR, ver
# next.config.js: output "standalone") fazendo a leitura inicial das
# páginas de conteúdo.)

# --- Firebase ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Tenant deste site dentro do banco compartilhado (dados/{tenant}/<colecao>)
# — o `path` de um cliente VIAMOB360 na coleção `cliente` do painel.
# Obrigatório, sem valor padrão. Case-sensitive!
# Onde ficam configuracoes_site, paginas_site, perguntas_frequentes,
# avisos_site, leads_site e a fila do chat (OmniChannel).
PORTAL_PATH=

